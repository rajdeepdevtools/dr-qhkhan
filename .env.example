# ==============================================================================
# DR. Q.H. KHAN CLASSICAL HOMOEOPATHIC CLINIC - MONOREPO ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' in local environment or configure these variables in Vercel / Render dashboards.

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mongodb.net/dr_qh_khan_clinic?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. SERVER & NODE ENVIRONMENT
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SECURITY
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_access_token_key_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. LOCAL DEVELOPMENT URLS (For localhost testing)
# ------------------------------------------------------------------------------
WEBSITE_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 5. DEPLOYED PRODUCTION URLS (For Vercel & Render)
# ------------------------------------------------------------------------------
PROD_WEBSITE_URL=https://www.theqhkhanclinic.com
PROD_ADMIN_URL=https://dr-qhkhan-admin.vercel.app
PROD_API_URL=https://dr-qhkhan.onrender.com/api
PROD_NEXT_PUBLIC_API_URL=https://dr-qhkhan.onrender.com/api

# ------------------------------------------------------------------------------
# 6. OBJECT & FILE STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET=medical-uploads
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# ------------------------------------------------------------------------------
# 7. INITIAL ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@drqhkhanclinic.com
ADMIN_INITIAL_PASSWORD=Admin@DrQHKhan1958!
