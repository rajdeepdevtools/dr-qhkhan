{
  "name": "hospital-portal",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:concurrently": "concurrently --kill-others -n \"backend,website,admin\" -c \"blue,green,magenta\" \"pnpm --filter backend dev\" \"pnpm --filter website dev\" \"pnpm --filter admin dev\"",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "seed": "pnpm --filter backend seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "20.x"
  }
}
